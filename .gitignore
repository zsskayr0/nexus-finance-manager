# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Tauri (Cargo.lock IS committed on purpose — this is an application, not a library)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# React Native / Expo
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.gradle/

# Env
.env
.env.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# SQLite local dev databases
*.sqlite
*.sqlite3
*.db

# Backups de CSV exportados pelo app (dados financeiros reais do usuário —
# nunca devem ir pro controle de versão)
nexus_backup_*.csv

# Dados persistentes do servidor (SQLite + anexos) em dev local — em Docker
# isso vive no volume /data, nunca na imagem
apps/server/data/

# Cópia local do build do frontend, só pra testar apps/server servindo a
# interface web sem Docker — no Dockerfile isso é copiado direto no build
apps/server/web/

# Chaves de assinatura Android — nunca versionadas (o keystore de release
# vive fora do repo; ver apps/desktop/src-tauri/gen/android/keystore.properties,
# que já está dentro de gen/ e por isso ignorado, mas essa regra fica de
# reforço caso esse arquivo algum dia saia de lá)
*.keystore
*.jks
keystore.properties
